---
export interface Props {
  id?: string;
  title: string;
  subtitle?: string;
  image: string;
  imageAlt: string;
  featureList: {
    title: string;
    desc: string;
  }[];
  reverse?: boolean;
}
const { id, title, subtitle, image, imageAlt, featureList, reverse = false } = Astro.props;
---

<section class="product-safety-enclosure" id={id}>
  <div class="container">
    <div class={`enclosure-row ${reverse ? 'row-reverse' : ''}`}>
      <div class="enclosure-media">
        <img src={image} alt={imageAlt} loading="lazy" />
      </div>
      <div class="enclosure-content">
        <h2>{title}</h2>
        {subtitle && <p class="enclosure-sub">{subtitle}</p>}
        <ul class="feature-list">
          {
            featureList.map((item) => (
              <li class="feature-item">
                <strong>{item.title}</strong>
                <span>{item.desc}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .product-safety-enclosure {
    padding: 5rem 0;
  }
  .container {
    max-width: 1440px;
    width: calc(100% - 4rem);
    margin: 0 auto;
  }
  .enclosure-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  .row-reverse {
    direction: rtl;
  }
  .row-reverse > * {
    direction: ltr;
  }
  .enclosure-media img {
    width: 100%;
    height: auto;
    border-radius: 10px;
  }
  .enclosure-content h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    color: #163a61;
    margin: 0 0 0.7rem;
  }
  .enclosure-sub {
    color: #505763;
    line-height: 1.7;
    margin: 0 0 2rem;
  }
  .feature-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }
  .feature-item {
    padding-left: 1.4rem;
    border-left: 3px solid #163a61;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .feature-item strong {
    color: #163a61;
    font-size: 1.05rem;
  }
  .feature-item span {
    color: #444;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  @media (max-width: 992px) {
    .enclosure-row {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .row-reverse {
      direction: ltr;
    }
  }
  @media (max-width: 768px) {
    .product-safety-enclosure {
      padding: 3rem 0;
    }
    .container {
      width: calc(100% - 2rem);
    }
  }
</style>
