---
export interface Props {
  productName: string;
  defaultSubject?: string;
}
const { productName, defaultSubject = 'Inquiry about laser machine' } = Astro.props;
---

<div class="inquire-modal-wrap" data-modal-wrap>
  <div class="modal-overlay" data-modal-close></div>
  <div class="modal-container">
    <button class="modal-close-btn" data-modal-close>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M18 6L6 18M6 6l12 12"></path>
      </svg>
    </button>
    <div class="modal-content">
      <h3 class="modal-title">Request Quotation</h3>
      <p class="modal-sub">Fill in the form, we will reply within 24 hours</p>
      <form class="inquire-form" data-inquire-form>
        <div class="form-row">
          <div class="form-group">
            <label>Your Name *</label>
            <input type="text" name="name" required placeholder="Your full name" />
          </div>
          <div class="form-group">
            <label>Company Name</label>
            <input type="text" name="company" placeholder="Company name" />
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Email Address *</label>
            <input type="email" name="email" required placeholder="business@email.com" />
          </div>
          <div class="form-group">
            <label>WhatsApp / Phone</label>
            <input type="text" name="phone" placeholder="Country code + number" />
          </div>
        </div>
        <div class="form-group">
          <label>Subject</label>
          <input type="text" name="subject" value={`${defaultSubject}: ${productName}`} />
        </div>
        <div class="form-group">
          <label>Message *</label>
          <textarea name="message" required rows="4" placeholder="Please describe your cutting material, thickness, working area and requirements..."></textarea>
        </div>
        <button type="submit" class="submit-btn">Send Inquiry</button>
      </form>
    </div>
  </div>
</div>

<style>
  .inquire-modal-wrap {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  .inquire-modal-wrap.is-open {
    display: flex;
  }
  .modal-overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.65);
  }
  .modal-container {
    position: relative;
    width: min(720px, 100%);
    max-height: 90vh;
    overflow-y: auto;
    background: #ffffff;
    border-radius: 14px;
    padding: 2rem;
  }
  .modal-close-btn {
    position: absolute;
    top: 1rem;
    right: 1rem;
    border: none;
    background: transparent;
    cursor: pointer;
    color: #64748b;
    padding: 0.4rem;
    border-radius: 6px;
    transition: 0.2s;
  }
  .modal-close-btn:hover {
    background: #f1f5f9;
    color: #163a61;
  }
  .modal-title {
    font-size: 1.6rem;
    color: #163a61;
    margin: 0 0 0.4rem;
  }
  .modal-sub {
    color: #525966;
    margin: 0 0 1.8rem;
    font-size: 0.95rem;
  }
  .inquire-form {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .form-group label {
    font-size: 0.9rem;
    color: #334155;
  }
  .form-group input,
  .form-group textarea {
    width: 100%;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 0.75rem 0.9rem;
    font-size: 0.95rem;
    transition: border-color 0.2s;
  }
  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: #163a61;
  }
  .submit-btn {
    width: 100%;
    padding: 0.9rem;
    margin-top: 0.6rem;
    background-color: #163a61;
    color: #fff;
    border: none;
    border-radius: 6px;
    font-size: 1rem;
    cursor: pointer;
    transition: background 0.24s;
  }
  .submit-btn:hover {
    background-color: #0f2946;
  }

  @media (max-width: 640px) {
    .form-row {
      grid-template-columns: 1fr;
    }
    .modal-container {
      padding: 1.4rem;
    }
    .modal-title {
      font-size: 1.35rem;
    }
  }

  .modal-wrap {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }
  .modal-wrap.open {
    display: flex;
  }
  .modal-shade {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.72);
  }
  .modal-box {
    position: relative;
    background: var(--color-white);
    border-radius: var(--radius-md);
    max-width: 720px;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    padding: 36px;
  }
  .modal-close-btn {
    position: absolute;
    top: 16px;
    right: 16px;
    background: none;
    border: none;
    font-size: 32px;
    cursor: pointer;
    color: var(--text-3);
  }
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 16px;
  }
  .form-group label {
    display: block;
    margin-bottom: 6px;
    font-weight: 600;
  }
  .form-control {
    width: 100%;
    padding: 11px;
    border: 1px solid rgba(var(--brand-main-rgb), 0.1);
    border-radius: var(--radius-sm);
    background: var(--bg-light);
  }
  .form-control:focus {
    outline: none;
    border-color: var(--brand-light);
    box-shadow: 0 0 0 1.5px rgba(var(--brand-main-rgb), 0.22);
  }
  .form-terms {
    margin: 24px 0;
  }
  .form-submit {
    text-align: center;
    margin-top: 28px;
  }

  @media screen and (max-width: 768px) {
    .form-row {
      grid-template-columns: 1fr;
    }
    .modal-box {
      padding: 24px;
    }
  }
</style>

<script>
  const modalWrap = document.querySelector<HTMLElement>('[data-modal-wrap]');
  const closeTriggers = document.querySelectorAll('[data-modal-close]');

  // 对外暴露全局打开方法，产品页面可调用 window.openInquireModal()
  (window as any).openInquireModal = function () {
    if (modalWrap) modalWrap.classList.add('is-open');
    document.body.style.overflow = 'hidden';
  };

  function closeModal() {
    if (modalWrap) modalWrap.classList.remove('is-open');
    document.body.style.overflow = '';
  }

  closeTriggers.forEach((el) => {
    el.addEventListener('click', closeModal);
  });

  // 表单提交事件（仅阻止默认，后端提交逻辑自行扩展）
  const form = document.querySelector<HTMLFormElement>('[data-inquire-form]');
  form?.addEventListener('submit', function (e) {
    e.preventDefault();
    alert('Form submit logic ready, connect mail/API here.');
    // fetch POST logic can be added here
  });
</script>
