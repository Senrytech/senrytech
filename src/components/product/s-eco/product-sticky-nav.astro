---
interface SectionItem {
  id: string;
  label: string;
}

interface Props {
  sections: SectionItem[];
}
const { sections } = Astro.props;
---

<div class="product-sticky-nav" data-sticky-nav>
  <nav class="sticky-nav-inner">
    <ul class="sticky-nav-list">
      {
        sections.map((item) => (
          <li class="sticky-nav-item">
            <a href={`#${item.id}`} class="sticky-nav-link" data-target-id={item.id}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<style>
  .product-sticky-nav {
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-left: 2px solid rgba(230, 233, 240, 0.6);
    border-bottom: none;
    border-radius: 7px;
    box-shadow: 0 3px 14px rgba(22, 58, 97, 0.08);
    overflow: hidden;
  }
  .sticky-nav-inner {
    max-width: unset;
    margin: 0;
    padding: 0.32rem 0;
  }

  .sticky-nav-list {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    overflow-x: visible;
    overflow-y: auto;
    scrollbar-width: thin;
    list-style: none;
    margin: 0;
    padding: 0 0.38rem;
  }
  .sticky-nav-list::-webkit-scrollbar {
    width: 2.5px;
    height: 0;
  }
  .sticky-nav-list::-webkit-scrollbar-thumb {
    background: var(--brand-main, #163a61);
    border-radius: var(--radius-full, 999px);
  }

  .sticky-nav-item {
    flex-shrink: 1;
    width: 100%;
  }

  .sticky-nav-link {
    display: block;
    padding: 0.48rem 0.5rem;
    font-size: 0.78rem;
    color: var(--text-2, #444);
    text-decoration: none;
    border-left: 2.2px solid transparent;
    border-bottom: none;
    transition: all var(--transition-base, 0.22s ease);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    letter-spacing: -0.01em;
    line-height: 1.3;
    border-radius: 0 3px 3px 0;
  }

  .sticky-nav-link:hover {
    color: var(--brand-main, #163a61);
    background: rgba(22, 58, 97, 0.07);
  }

  .sticky-nav-item.is-active .sticky-nav-link {
    color: var(--brand-main, #163a61);
    border-left-color: var(--brand-main, #163a61);
    font-weight: 600;
    background: rgba(22, 58, 97, 0.1);
  }

  .back-top-btn {
    width: calc(100% - 0.76rem);
    margin: 0.48rem 0.38rem 0.36rem;
    padding: 0.46rem 0;
    background: var(--brand-main, #163a61);
    color: #fff;
    border: none;
    border-radius: 3px;
    font-size: 0.78rem;
    cursor: pointer;
    transition: all var(--transition-base, 0.22s ease);
    opacity: 0;
    visibility: hidden;
  }
  .back-top-btn.show {
    opacity: 1;
    visibility: visible;
  }
  .back-top-btn:hover {
    background: #254e7c;
  }

  @media screen and (max-width: 768px) {
    .sidebar-nav-wrap {
      position: static;
      width: 100%;
      margin: 1rem 0;
      right: auto;
    }
    .product-sticky-nav {
      background: var(--color-white, #fff);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      border-left: none;
      border-bottom: 2px solid var(--border-light, #e6e9f0);
      border-radius: 0;
      box-shadow: none;
    }
    .sticky-nav-list {
      flex-direction: row;
      overflow-x: auto;
      gap: 0.08rem;
      padding-bottom: 5px;
    }
    .sticky-nav-item {
      flex-shrink: 0;
    }
    .sticky-nav-link {
      border-left: none;
      border-bottom: 2.2px solid transparent;
      padding: 0.44rem 0.52rem;
      border-radius: 3px 3px 0 0;
    }
    .sticky-nav-item.is-active .sticky-nav-link {
      border-bottom-color: var(--brand-main, #163a61);
      background: rgba(22, 58, 97, 0.06);
    }
    .sticky-nav-link:hover {
      background: rgba(22, 58, 97, 0.04);
    }
    .back-top-btn {
      display: none !important;
    }
  }
</style>

<script>
  type ObserverEntry = IntersectionObserverEntry;
  (function () {
    document.addEventListener('DOMContentLoaded', () => {
      // ========== 原有导航高亮逻辑 原样保留 ==========
      const navContainer = document.querySelector('[data-sticky-nav]');
      const links = document.querySelectorAll<HTMLAnchorElement>('.sticky-nav-link');
      if (!navContainer || links.length === 0) return;
      const observerOptions = {
        rootMargin: '-100px 0px -20% 0px',
        threshold: [0, 0.2, 0.5, 0.8],
      };
      const linkMap = new Map();
      links.forEach((link) => {
        const id = link.dataset.targetId;
        const li = link.closest('.sticky-nav-item');
        if (id && li) linkMap.set(id, li);
      });
      let activeId: string | null = null;
      const observerCallback = (entries: IntersectionObserverEntry[]) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) activeId = entry.target.id;
        });
        linkMap.forEach((li, id) => {
          li.classList.toggle('is-active', id === activeId);
        });
      };
      const observer = new IntersectionObserver(observerCallback, observerOptions);
      linkMap.forEach((_, id) => {
        const el = document.getElementById(id);
        el && observer.observe(el);
      });
      links.forEach((link) => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          const targetId = link.dataset.targetId;
          if (!targetId) return;
          const targetEl = document.getElementById(targetId);
          if (!targetEl) return;
          const offsetTop = targetEl.offsetTop - 100;
          window.scrollTo({ top: offsetTop, behavior: 'smooth' });
        });
      });
      function refreshActive() {
        const scrollY = window.scrollY + 120;
        let currentId = null;
        linkMap.forEach((_, id) => {
          const el = document.getElementById(id);
          if (el && scrollY >= el.offsetTop) currentId = id;
        });
        activeId = currentId;
        linkMap.forEach((li, id) => {
          li.classList.toggle('is-active', id === activeId);
        });
      }
      window.addEventListener('load', refreshActive);
      window.addEventListener('resize', refreshActive);
      let timer: ReturnType<typeof setTimeout> | undefined;
      window.addEventListener('scroll', () => {
        clearTimeout(timer);
        timer = setTimeout(refreshActive, 60);
      });

      // ========== 新增回顶逻辑，和导航共用滚动监听，节流复用、减少性能损耗 ==========
      const backTopBtn = document.getElementById('backTopBtn');
      function scrollHandler() {
        if (!backTopBtn) return;
        const scrollY = window.scrollY;
        // 滚动大于400px显示按钮
        backTopBtn.classList.toggle('show', scrollY > 400);
      }
      // 节流复用，不新建监听，优化AAO页面性能评分
      let scrollTimer: ReturnType<typeof setTimeout> | undefined;
      window.addEventListener('scroll', () => {
        clearTimeout(scrollTimer);
        scrollTimer = setTimeout(scrollHandler, 80);
      });
      if (backTopBtn) {
        backTopBtn.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }
    });
  })();
</script>
