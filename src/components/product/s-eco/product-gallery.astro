---
export interface GalleryImage {
  thumbnail: string;
  original: string;
  alt: string;
}

export interface Props {
  id?: string;
  sectionTitle?: string;
  imageList: GalleryImage[];
}
const { id, sectionTitle, imageList } = Astro.props;
---

<section class="product-gallery" id={id}>
  <div class="container">
    {
      sectionTitle && (
        <div class="section-header">
          <h2>{sectionTitle}</h2>
        </div>
      )
    }

    <div class="gallery-swiper">
      <div class="swiper-main">
        {
          imageList.map((img) => (
            <div class="swiper-slide">
              <img src={img.original} alt={img.alt} loading="lazy" />
            </div>
          ))
        }
      </div>
      <div class="swiper-thumbs">
        {
          imageList.map((img) => (
            <div class="thumb-slide">
              <img src={img.thumbnail} alt={img.alt} loading="lazy" />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .product-gallery {
    padding: 5rem 0;
    background: #ffffff;
  }
  .container {
    max-width: 1440px;
    width: calc(100% - 4rem);
    margin: 0 auto;
  }
  .section-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }
  .section-header h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    color: #163a61;
    margin: 0;
  }

  .gallery-swiper {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .swiper-main {
    width: 100%;
    aspect-ratio: 16 / 10;
    background: #f3f6fa;
    border-radius: 12px;
    overflow: hidden;
  }
  .swiper-slide {
    width: 100%;
    height: 100%;
    display: none;
  }
  .swiper-slide img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .swiper-thumbs {
    display: flex;
    gap: 0.8rem;
    overflow-x: auto;
    scrollbar-width: thin;
    padding-bottom: 0.4rem;
  }
  .swiper-thumbs::-webkit-scrollbar {
    height: 3px;
  }
  .swiper-thumbs::-webkit-scrollbar-thumb {
    background: #b8c2cc;
    border-radius: 99px;
  }
  .thumb-slide {
    flex-shrink: 0;
    width: 110px;
    height: 70px;
    border-radius: 6px;
    overflow: hidden;
    border: 2px solid transparent;
    cursor: pointer;
    opacity: 0.65;
    transition: 0.2s ease;
  }
  .thumb-slide.active {
    border-color: #163a61;
    opacity: 1;
  }
  .thumb-slide:hover {
    opacity: 1;
  }
  .thumb-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 768px) {
    .product-gallery {
      padding: 3rem 0;
    }
    .container {
      width: calc(100% - 2rem);
    }
    .thumb-slide {
      width: 86px;
      height: 56px;
    }
  }

  .gallery-img-item img {
    width: 100%;
    border-radius: var(--radius-sm);
    object-fit: cover;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const mainWrap = document.querySelector('.swiper-main');
    if (!mainWrap) return;

    const mainSlides = Array.from(document.querySelectorAll('.swiper-main .swiper-slide')) as HTMLElement[];
    const thumbSlides = Array.from(document.querySelectorAll('.thumb-slide')) as HTMLElement[];

    if (!mainSlides.length || !thumbSlides.length) return;

    let activeIndex = 0;
    thumbSlides[activeIndex].classList.add('active');

    function switchSlide(index: number) {
      activeIndex = index;
      mainSlides.forEach((slide, i) => {
        slide.style.display = i === index ? 'block' : 'none';
      });
      thumbSlides.forEach((thumb, i) => {
        thumb.classList.toggle('active', i === index);
      });
    }

    thumbSlides.forEach((thumb, idx) => {
      thumb.addEventListener('click', () => switchSlide(idx));
    });

    switchSlide(activeIndex);
  });
</script>
