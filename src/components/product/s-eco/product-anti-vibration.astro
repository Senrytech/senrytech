---
export interface Props {
  id?: string;
  title: string;
  subtitle?: string;
  bgImage: string;
  featureList: {
    title: string;
    desc: string;
  }[];
}
const { id, title, subtitle, bgImage, featureList } = Astro.props;
---

<section class="product-anti-vibration" id={id}>
  <div class="vib-bg">
    <img src={bgImage} alt={title} loading="lazy" />
  </div>
  <div class="container">
    <div class="vib-content-wrap">
      <h2>{title}</h2>
      {subtitle && <p class="vib-sub">{subtitle}</p>}
      <div class="vib-feature-grid">
        {
          featureList.map((item) => (
            <div class="vib-card">
              <h3>{item.title}</h3>
              <p>{item.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .product-anti-vibration {
    position: relative;
    padding: 7rem 0;
    color: #fff;
    overflow: hidden;
  }
  .vib-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .vib-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .vib-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background-color: rgba(12, 22, 36, 0.78);
  }
  .container {
    position: relative;
    z-index: 2;
    max-width: 1440px;
    width: calc(100% - 4rem);
    margin: 0 auto;
  }
  .vib-content-wrap {
    max-width: 920px;
  }
  .vib-content-wrap h2 {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    margin: 0 0 0.8rem;
  }
  .vib-sub {
    color: #d1d9e3;
    font-size: 1.02rem;
    line-height: 1.7;
    margin: 0 0 2.8rem;
    max-width: 760px;
  }
  .vib-feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.6rem;
  }
  .vib-card {
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 10px;
    padding: 1.8rem 1.4rem;
    background-color: rgba(255, 255, 255, 0.04);
    transition: 0.25s ease;
  }
  .vib-card:hover {
    border-color: #163a61;
    background-color: rgba(22, 58, 97, 0.22);
  }
  .vib-card h3 {
    font-size: 1.15rem;
    margin: 0 0 0.6rem;
    color: #ffffff;
  }
  .vib-card p {
    margin: 0;
    color: #c4cdd8;
    font-size: 0.93rem;
    line-height: 1.65;
  }

  @media (max-width: 768px) {
    .product-anti-vibration {
      padding: 4rem 0;
    }
    .container {
      width: calc(100% - 2rem);
    }
    .vib-feature-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
