---
export interface Props {
  id?: string;
  title: string;
  subtitle?: string;
  list: {
    icon: string;
    title: string;
    desc: string;
  }[];
}
const { id, title, subtitle, list } = Astro.props;
---

<section class="product-selling-point" id={id}>
  <div class="container">
    <div class="section-head">
      <h2>{title}</h2>
      {subtitle && <p class="section-sub">{subtitle}</p>}
    </div>
    <div class="point-grid">
      {
        list.map((item) => (
          <div class="point-card">
            <div class="point-icon">
              <img src={item.icon} alt={`${item.title} - ${item.desc}`} loading="lazy" />
            </div>
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .product-selling-point {
    padding: 5rem 0;
  }
  .container {
    max-width: 1440px;
    width: calc(100% - 4rem);
    margin: 0 auto;
  }
  .section-head {
    text-align: center;
    margin-bottom: 3rem;
  }
  .section-head h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    color: #163a61;
    margin: 0 0 0.6rem;
  }
  .section-sub {
    max-width: 780px;
    margin: 0 auto;
    color: #555;
    font-size: 1rem;
    line-height: 1.7;
  }
  .point-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 2rem;
  }
  .point-card {
    padding: 2rem 1.6rem;
    border: 1px solid #e7ecf2;
    border-radius: 12px;
    transition: 0.2s ease;
  }
  .point-card:hover {
    border-color: #163a61;
    box-shadow: 0 8px 24px rgba(22, 58, 97, 0.08);
  }
  .point-card:active {
    transform: scale(0.97);
  }
  .point-icon {
    width: 56px;
    height: 56px;
    margin-bottom: 12px;
  }
  .point-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .point-card h3 {
    font-size: 1.15rem;
    color: #163a61;
    margin: 0 0 0.6rem;
    line-height: 1.3;
  }
  .point-card p {
    color: #545964;
    line-height: 1.65;
    margin: 0;
    font-size: 0.95rem;
  }

  @media (max-width: 768px) {
    .product-selling-point {
      padding: 3rem 0;
    }
    .container {
      width: calc(100% - 2rem);
    }
    .point-grid {
      gap: 1.4rem;
    }
    .point-card {
      padding: 1.6rem 1.2rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    * {
      transition: none !important;
    }
  }
</style>
