---
export interface Props {
  id?: string;
  sectionTitle: string;
  sectionSubtitle?: string;
  tableHead: string[];
  tableRows: string[][];
}
const { id, sectionTitle, sectionSubtitle, tableHead, tableRows } = Astro.props;
---

<section class="product-cutting-performance" id={id}>
  <div class="container">
    <div class="section-header">
      <h2>{sectionTitle}</h2>
      {sectionSubtitle && <p class="section-desc">{sectionSubtitle}</p>}
    </div>

    <div class="table-wrap">
      <table class="cut-table">
        <thead>
          <tr>
            {tableHead.map((th) => <th>{th}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            tableRows.map((row) => (
              <tr>
                {row.map((cell) => (
                  <td>{cell}</td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .product-cutting-performance {
    padding: 5rem 0;
    background-color: #f8fafc;
  }
  .container {
    max-width: 1440px;
    width: calc(100% - 4rem);
    margin: 0 auto;
  }
  .section-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }
  .section-header h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    color: #163a61;
    margin: 0 0 0.6rem;
  }
  .section-desc {
    max-width: 800px;
    margin: 0 auto;
    color: #525966;
    line-height: 1.7;
  }

  .table-wrap {
    overflow-x: auto;
  }
  .cut-table {
    width: 100%;
    border-collapse: collapse;
    background: #fff;
    border-radius: 10px;
    overflow: hidden;
    min-width: 640px;
  }
  .cut-table thead tr {
    background-color: #163a61;
  }
  .cut-table th {
    color: #ffffff;
    padding: 1rem 0.8rem;
    font-weight: 500;
    font-size: 0.95rem;
    text-align: center;
    white-space: nowrap;
  }
  .cut-table td {
    padding: 0.9rem 0.8rem;
    font-size: 0.92rem;
    text-align: center;
    color: #333;
    border-bottom: 1px solid #e4e9f0;
  }
  .cut-table tbody tr:nth-child(even) {
    background-color: #f6f8fc;
  }
  .cut-table tbody tr:hover {
    background-color: #eef3fa;
  }

  @media (max-width: 768px) {
    .product-cutting-performance {
      padding: 3rem 0;
    }
    .container {
      width: calc(100% - 2rem);
    }
    .cut-table th {
      padding: 0.8rem 0.6rem;
      font-size: 0.86rem;
    }
    .cut-table td {
      padding: 0.7rem 0.6rem;
      font-size: 0.84rem;
    }
  }
</style>
