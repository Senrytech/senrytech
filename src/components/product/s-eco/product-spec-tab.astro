---
export interface SpecTabItem {
  tabLabel: string;
  tableHead: string[];
  tableRows: string[][];
}
export interface Props {
  id?: string;
  sectionTitle: string;
  sectionSubtitle?: string;
  note?: string;
  tabList: SpecTabItem[];
  addAnimation?: boolean;
}
const { id, sectionTitle, sectionSubtitle, note, tabList, addAnimation = false } = Astro.props;
const wrapClass = addAnimation ? 'spec-tabs-wrap fade-observe' : '';
---

<section class="product-spec-tab {wrapClass}" {id}>
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">{sectionTitle}</h2>
      {sectionSubtitle && <p class="section-subtitle">{sectionSubtitle}</p>}
      {note && <p class="section-desc">{note}</p>}
    </div>
    <div class="spec-tab-wrap">
      <div class="spec-tab-buttons">
        {
          tabList.map((item, idx) => (
            <button class={`spec-tab-btn ${idx === 0 ? 'active' : ''}`} data-tab-index={idx}>
              {item.tabLabel}
            </button>
          ))
        }
      </div>
      <div class="spec-tab-contents">
        {
          tabList.map((item, idx) => (
            <div class={`spec-tab-panel ${idx === 0 ? 'active' : ''}`} data-panel-index={idx}>
              <div class="table-scroll">
                <table class="spec-table">
                  <thead>
                    <tr>
                      {item.tableHead.map((th) => (
                        <th>{th}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {item.tableRows.map((row) => (
                      <tr>
                        {row.map((cell) => (
                          <td>{cell}</td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .product-spec-tab {
    padding: var(--base-gap) 0;
    background: var(--grad-glass-transparent);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
  }
  .container {
    max-width: 1120px;
    width: calc(100% - 2rem);
    margin: 0 auto;
  }
  .section-header {
    text-align: center;
    margin-bottom: var(--base-gap);
  }
  .section-title {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    color: var(--brand-main);
    margin: 0 0 0.6rem;
    font-weight: 600;
  }
  .section-subtitle {
    max-width: 860px;
    margin: 0 auto 0.5rem;
    color: var(--text-2);
    line-height: 1.65;
  }
  .section-desc {
    max-width: 860px;
    margin: 0 auto;
    color: var(--text-3);
    line-height: 1.7;
  }
  .spec-tab-wrap {
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-medium);
    border: 1px solid rgba(var(--brand-main-rgb), 0.08);
    padding: 1.6rem;
  }
  .spec-tab-buttons {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
    border-bottom: 1px solid rgba(var(--brand-main-rgb), 0.1);
  }
  .spec-tab-btn {
    border: none;
    background: transparent;
    font-size: 0.98rem;
    padding: 0.9rem 1.4rem;
    cursor: pointer;
    color: var(--text-2);
    border-bottom: 3px solid transparent;
    transition: var(--transition-base);
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
  }
  .spec-tab-btn:hover {
    color: var(--brand-hover);
    background: var(--hover-bg);
  }
  .spec-tab-btn.active {
    color: var(--brand-main);
    border-color: var(--brand-main);
    font-weight: 500;
  }
  .spec-tab-panel {
    display: none;
  }
  .spec-tab-panel.active {
    display: block;
  }
  .table-scroll {
    overflow-x: auto;
    border-radius: var(--radius-sm);
  }
  .spec-table {
    width: 100%;
    border-collapse: collapse;
    background: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(10px);
    min-width: 600px;
  }
  .spec-table th {
    background: var(--brand-main);
    color: #fff;
    padding: 0.9rem 0.7rem;
    font-weight: 500;
    font-size: 0.94rem;
    text-align: center;
    white-space: nowrap;
  }
  .spec-table td {
    padding: 0.8rem 0.7rem;
    font-size: 0.9rem;
    color: var(--text-2);
    text-align: center;
    border-bottom: 1px solid rgba(var(--brand-main-rgb), 0.07);
  }
  .spec-table tbody tr:nth-child(even) {
    background: rgba(var(--brand-main-rgb), 0.04);
  }
  .spec-table tbody tr:hover {
    background: var(--hover-bg);
    transition: var(--transition-base);
  }
  @media (max-width: 1024px) {
    .product-spec-tab {
      padding: 3rem 0;
    }
  }
  @media (max-width: 768px) {
    .product-spec-tab {
      padding: 2.4rem 0;
    }
    .container {
      width: calc(100% - 1rem);
    }
    .spec-tab-wrap {
      padding: 1rem;
    }
    .spec-tab-btn {
      padding: 0.7rem 1rem;
      font-size: 0.9rem;
    }
    .spec-table th {
      padding: 0.7rem 0.5rem;
      font-size: 0.84rem;
    }
    .spec-table td {
      padding: 0.6rem 0.5rem;
      font-size: 0.82rem;
    }
  }
</style>

<script>
  const tabButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.spec-tab-btn'));
  const tabPanels = Array.from(document.querySelectorAll<HTMLElement>('.spec-tab-panel'));

  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const idx = btn.dataset.tabIndex;
      if (idx === undefined) return;

      tabButtons.forEach((b) => b.classList.remove('active'));
      tabPanels.forEach((p) => p.classList.remove('active'));
      btn.classList.add('active');
      document.querySelector<HTMLElement>(`[data-panel-index="${idx}"]`)?.classList.add('active');
    });
  });
</script>
