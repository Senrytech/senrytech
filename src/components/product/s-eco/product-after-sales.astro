---
export interface Props {
  id?: string;
  sectionTitle: string;
  sectionSubtitle?: string;
  serviceList: string[];
}
const { id, sectionTitle, sectionSubtitle, serviceList } = Astro.props;
---

<section class="product-aftersales" id={id}>
  <div class="container">
    <div class="section-header">
      <h2>{sectionTitle}</h2>
      {sectionSubtitle && <p class="section-desc">{sectionSubtitle}</p>}
    </div>

    <div class="aftersales-grid">
      {
        serviceList.map((text) => (
          <div class="aftersales-card">
            <p>{text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .product-aftersales {
    padding: 5rem 0;
  }
  .container {
    max-width: 1440px;
    width: calc(100% - 4rem);
    margin: 0 auto;
  }
  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }
  .section-header h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    color: #163a61;
    margin: 0 0 0.6rem;
  }
  .section-desc {
    max-width: 800px;
    margin: 0 auto;
    color: #525966;
    line-height: 1.7;
  }

  .aftersales-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
  }
  .aftersales-card {
    text-align: center;
    padding: 2rem 1.4rem;
    border: 1px solid #e7ecf2;
    border-radius: 12px;
    transition: 0.24s ease;
  }
  .aftersales-card:hover {
    border-color: #163a61;
    box-shadow: 0 8px 24px rgba(22, 58, 97, 0.08);
  }
  .aftersales-icon {
    width: 60px;
    height: 60px;
    margin: 0 auto 1rem;
  }
  .aftersales-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .aftersales-card h3 {
    font-size: 1.1rem;
    color: #163a61;
    margin: 0 0 0.6rem;
  }
  .aftersales-card p {
    margin: 0;
    font-size: 0.93rem;
    color: #475569;
    line-height: 1.65;
  }

  @media (max-width: 768px) {
    .product-aftersales {
      padding: 3rem 0;
    }
    .container {
      width: calc(100% - 2rem);
    }
    .aftersales-grid {
      grid-template-columns: 1fr 1fr;
      gap: 1.2rem;
    }
    .aftersales-card {
      padding: 1.4rem 1rem;
    }
  }
</style>
