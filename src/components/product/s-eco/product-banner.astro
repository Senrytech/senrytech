---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  breadcrumbs: {
    label: string;
    href: string;
  }[];
  productName: string;
  subTitle?: string;
  highlightKey?: string;
  bannerPc?: ImageMetadata;
  bannerMobile?: ImageMetadata;
  bannerUrlPc?: string;
  bannerUrlMobile?: string;
  pcAlt: string;
  mobileAlt: string;
}

const { breadcrumbs, productName, subTitle, bannerPc, bannerMobile, bannerUrlPc, bannerUrlMobile, pcAlt, mobileAlt } = Astro.props;
const highlightKey = Astro.props.highlightKey || 'S-ECO';
const renderHighlightName = () => {
  const target = highlightKey;
  if (!productName.includes(target)) return productName;
  return productName.replace(target, `<span class="model-name">${target}</span>`);
};
---

<section class="product-banner">
  <div class="banner-bg pc">
    {
      bannerPc ? (
        <Image src={bannerPc} alt={pcAlt} class="banner-img" sizes="100vw" width={1920} height={1080} decoding="async" />
      ) : bannerUrlPc ? (
        <img src={bannerUrlPc} alt={pcAlt} class="banner-img" loading="eager" />
      ) : null
    }
  </div>

  <div class="banner-bg mobile">
    {
      bannerMobile ? (
        <Image src={bannerMobile} alt={mobileAlt} class="banner-img" sizes="100vw" width={750} height={1334} decoding="async" />
      ) : bannerUrlMobile ? (
        <img src={bannerUrlMobile} alt={mobileAlt} class="banner-img" loading="eager" />
      ) : null
    }
  </div>

  <div class="banner-container">
    <nav class="breadcrumb" aria-label="Breadcrumb navigation">
      <ol>
        {
          breadcrumbs.map((item, idx) => (
            <li>
              {idx === breadcrumbs.length - 1 ? (
                <span>{item.label}</span>
              ) : (
                <>
                  <a href={item.href}>{item.label}</a>
                  <span class="sep">/</span>
                </>
              )}
            </li>
          ))
        }
      </ol>
    </nav>
    <div class="banner-text">
      <h1><span class="model-name">S-ECO</span> Series Fiber Laser Sheet<br />Cutting Machine</h1>
      {subTitle && <p class="banner-sub">{subTitle}</p>}
    </div>
  </div>
</section>

<style>
  html {
    scroll-behavior: smooth !important;
  }
  .product-banner {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    min-height: 360px;
    overflow: hidden;
    display: flex;
    align-items: flex-start;
    padding-top: 10%;
  }
  .product-banner::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(ellipse at center, transparent 58%, rgba(0, 0, 0, 0.34) 100%),
      linear-gradient(to right, rgba(0, 0, 0, 0.44), transparent 34%, transparent 66%, rgba(0, 0, 0, 0.28));
    pointer-events: none;
  }
  .banner-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
  }
  .banner-bg.mobile {
    display: none;
  }
  .banner-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
  }
  .banner-container {
    position: relative;
    z-index: 3;
    width: min(1440px, calc(100% - 4rem));
    margin: 0 auto;
    padding: 2rem 0;
  }
  .breadcrumb ol {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0 0 1.2rem;
    padding: 0;
    font-size: 0.85rem;
    color: #cccccc;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.35);
  }
  .breadcrumb a {
    color: #bbbbbb;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .breadcrumb a:hover {
    color: #ffffff;
    text-decoration: underline;
  }
  .breadcrumb .sep {
    opacity: 0.55;
  }
  .breadcrumb span {
    color: #eeeeee;
  }
  .banner-text h1 {
    font-size: clamp(2.3rem, 5.8vw, 4rem);
    margin: 0;
    line-height: 1.2;
    font-weight: 700;
    color: #ffffff;
    text-shadow:
      0 2px 9px rgba(0, 0, 0, 0.6),
      0 1px 3px rgba(0, 0, 0, 0.75);
    word-break: normal;
  }
  .model-name {
    color: var(--brand-hover);
    text-shadow:
      0 0 10px rgba(var(--brand-main-rgb), 0.6),
      0 2px 7px rgba(0, 0, 0, 0.68);
  }
  .banner-sub {
    font-size: 1.02rem;
    margin: 0.9rem 0 0;
    max-width: 820px;
    line-height: 1.65;
    color: #f1f1f1;
    text-shadow: 0 1px 5px rgba(0, 0, 0, 0.55);
  }
  .right-side-nav {
    position: fixed;
    right: 12px !important;
    top: 20vh !important;
    transform: none !important;
    z-index: 95;
  }
  .right-side-nav a[href='#top'] {
    cursor: pointer;
    scroll-margin-top: 0;
  }
  #top {
    scroll-behavior: smooth;
    scroll-margin-top: 0;
  }
  @media (max-width: 768px) {
    .product-banner {
      aspect-ratio: 9 / 16;
      min-height: 260px;
      padding-top: 14%;
    }
    .banner-bg.pc {
      display: none;
    }
    .banner-bg.mobile {
      display: block;
    }
    .banner-container {
      width: calc(100% - 2rem);
    }
    .breadcrumb ol {
      font-size: 0.78rem;
    }
    .banner-text h1 {
      font-size: clamp(1.9rem, 5.2vw, 3rem);
      text-shadow:
        0 2px 10px rgba(0, 0, 0, 0.65),
        0 1px 4px rgba(0, 0, 0, 0.8);
    }
    .banner-sub {
      font-size: 0.94rem;
    }
    .right-side-nav {
      right: 10px;
    }
  }
</style>
