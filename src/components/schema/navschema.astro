---
interface Props {
  locale: string;
  siteUrl: string;
  navData: Array<{
    label: string;
    href: string;
  }>;
}
const { locale, siteUrl, navData } = Astro.props;

// 清理域名末尾斜杠，避免双斜杠问题
const baseUrl = siteUrl.endsWith('/') ? siteUrl.slice(0, -1) : siteUrl;

// 适配路由：英文首页 = domain/，其他语种 = domain/{locale}/
const navRootUrl = locale === 'en' ? `${baseUrl}/` : `${baseUrl}/${locale}/`;

const navschema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'NavigationElement',
  name: 'Main Navigation',
  description: 'Senrytech Laser official website main navigation for industrial laser equipment',
  url: navRootUrl,
  publisher: {
    '@type': 'Organization',
    'name': 'Senrytech Laser',
    'alternateName': 'Senrytech'
  },
  hasItemList: {
    '@type': 'ItemList',
    itemListOrder: 'ItemListOrderAscending',
    itemListElement: navData.map((item, idx) => ({
      position: idx + 1,
      name: item.label,
      item: `${baseUrl}${item.href}`
    }))
  }
});
---
<script type="application/ld+json">
{navschema}
</script>