---
interface Props {
  locale: string;
}
const { locale } = Astro.props;
const isEn = locale.startsWith('en');

import { Image } from 'astro:assets';
import imgEcuador from '../../assets/images/case/ecuador-fabrication.webp';
import imgPeru from '../../assets/images/case/peru-mining.webp';
import imgBrazil from '../../assets/images/case/brazil-heavy-plate.webp';
import imgIndonesia from '../../assets/images/case/indonesia-tube.webp';
import imgArgentina from '../../assets/images/case/argentina-factory.webp';
---

<!-- 【重要】放到最顶部，优先加载Swiper资源 -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
<script is:inline src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

<section class="home-customer-cases">
  <div class="container">
    <h2 class="section-heading">Global Customer Installation Cases</h2>
    <p class="cases-subtitle">24/7 Multilingual Remote Support & Standard Global Export Process</p>
  </div>

  <div class="case-carousel swiper" id="caseCarousel">
    <div class="carousel-mask mask-left"></div>
    <div class="carousel-mask mask-right"></div>

    <div class="swiper-wrapper">
      <div class="swiper-slide carousel-slide">
        <div class="slide-inner">
          <div class="slide-img-wrap">
            <Image class="slide-img" src={imgEcuador} alt="Ecuador Case" loading="lazy" width={1600} height={1000} />
          </div>
          <div class="slide-text-panel">
            <div class="slide-label">Ecuador · Agricultural & Steel Structure</div>
            <h3 class="slide-title">A Reliable Steel Structure Partner</h3>
            <p class="slide-desc">High-precision laser cutting solutions support local agricultural and steel fabrication projects.</p>
            <a href="/en/insights/case-stories" class="slide-link">Learn More →</a>
          </div>
        </div>
      </div>
      <div class="swiper-slide carousel-slide">
        <div class="slide-inner">
          <div class="slide-img-wrap">
            <Image class="slide-img" src={imgPeru} alt="Peru Case" loading="lazy" width={1600} height={1000} />
          </div>
          <div class="slide-text-panel">
            <div class="slide-label">Peru · Heavy Mining Metal Fabrication</div>
            <h3 class="slide-title">Heavy-Duty Mining Metal Cutting</h3>
            <p class="slide-desc">Stable fiber laser equipment handles thick metal plates for mining equipment fabrication.</p>
            <a href="/en/insights/case-stories" class="slide-link">Learn More →</a>
          </div>
        </div>
      </div>
      <div class="swiper-slide carousel-slide">
        <div class="slide-inner">
          <div class="slide-img-wrap">
            <Image class="slide-img" src={imgIndonesia} alt="Indonesia Case" loading="lazy" width={1600} height={1000} />
          </div>
          <div class="slide-text-panel">
            <div class="slide-label">Indonesia · Tube & Pipe Processing</div>
            <h3 class="slide-title">Efficient Tube & Pipe Processing</h3>
            <p class="slide-desc">Integrated sheet and tube laser systems improve workshop efficiency and part accuracy.</p>
            <a href="/en/insights/case-stories" class="slide-link">Learn More →</a>
          </div>
        </div>
      </div>
      <div class="swiper-slide carousel-slide">
        <div class="slide-inner">
          <div class="slide-img-wrap">
            <Image class="slide-img" src={imgBrazil} alt="Brazil Case" loading="lazy" width={1600} height={1000} />
          </div>
          <div class="slide-text-panel">
            <div class="slide-label">Brazil · Heavy Carbon Steel Cutting</div>
            <h3 class="slide-title">40kW Ultra High Power Solution</h3>
            <p class="slide-desc">Heavy carbon steel cutting with strong penetration and consistent production capacity.</p>
            <a href="/en/insights/case-stories" class="slide-link">Learn More →</a>
          </div>
        </div>
      </div>
      <div class="swiper-slide carousel-slide">
        <div class="slide-inner">
          <div class="slide-img-wrap">
            <Image class="slide-img" src={imgArgentina} alt="Argentina Case" loading="lazy" width={1600} height={1000} />
          </div>
          <div class="slide-text-panel">
            <div class="slide-label">Argentina · Metal Fabrication Workshop</div>
            <h3 class="slide-title">Local Workshop Production Upgrade</h3>
            <p class="slide-desc">Flexible laser cutting lines help local manufacturers improve delivery speed and quality.</p>
            <a href="/en/insights/case-stories" class="slide-link">Learn More →</a>
          </div>
        </div>
      </div>
    </div>

    <div class="carousel-arrow prev-btn swiper-button-prev"></div>
    <div class="carousel-arrow next-btn swiper-button-next"></div>
  </div>

  <div class="container">
    <div class="cases-more-wrap">
      <a href="/en/insights/case-stories" class="cases-more-link">View More Regional Case Stories →</a>
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    // 等待Swiper全局变量就绪
    const waitSwiper = setInterval(() => {
      if (window.Swiper) {
        clearInterval(waitSwiper);
        initSlider();
      }
    }, 50);

    function initSlider() {
      const caseSwiper = new Swiper('#caseCarousel', {
        slidesPerView: 'auto',
        spaceBetween: 16,
        centeredSlides: true,
        loop: true,
        initialSlide: 1,
        speed: 340, // 滑动动画时长，显式开启动画
        autoplay: {
          delay: 4500,
          disableOnInteraction: false,
        },
        pauseOnMouseEnter: true,
        navigation: {
          prevEl: '.swiper-button-prev',
          nextEl: '.swiper-button-next',
        },
        on: {
          slideChange: function () {
            this.slides.forEach((item) => item.classList.remove('active'));
            this.slides[this.activeIndex].classList.add('active');
          },
        },
      });
    }
  });
</script>

<style>
  html,
  body {
    overflow-x: hidden;
  }
  .home-customer-cases {
    padding: clamp(64px, 6vw, 96px) 0;
  }
  .home-customer-cases .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .section-heading {
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    margin: 0 0 12px;
    color: var(--text-1);
    text-align: center;
  }
  .cases-subtitle {
    color: var(--text-2);
    margin: 0 auto 36px;
    max-width: 820px;
    text-align: center;
  }

  .case-carousel {
    position: relative;
    overflow: hidden;
    margin-bottom: 32px;
    width: min(100vw, 100%);
    left: 50%;
    transform: translateX(-50%);
  }
  .carousel-mask {
    position: absolute;
    top: 0;
    width: 100px;
    height: 100%;
    z-index: 2;
    pointer-events: none;
  }
  .mask-left {
    left: 0;
    background: linear-gradient(90deg, #f8fafc 85%, transparent);
  }
  .mask-right {
    right: 0;
    background: linear-gradient(-90deg, #f8fafc 85%, transparent);
  }

  .carousel-slide {
    width: 740px;
    transition: all 0.34s ease;
  }
  .slide-inner {
    display: grid;
    grid-template-columns: 56% 44%;
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: #f8f8f8;
    transition:
      transform 0.34s ease,
      filter 0.34s ease,
      opacity 0.34s ease;
  }
  .slide-img-wrap {
    overflow: hidden;
  }
  .slide-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .carousel-slide:not(.active) .slide-inner {
    transform: scale(0.93);
    opacity: 0.62;
    filter: blur(0.6px);
  }
  .carousel-slide.active .slide-inner {
    transform: scale(1);
    opacity: 1;
    filter: blur(0);
    box-shadow: var(--shadow-medium);
  }

  .slide-text-panel {
    padding: 36px 28px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    color: var(--text-1);
  }
  .slide-label {
    font-size: 0.86rem;
    opacity: 0.72;
    margin-bottom: 10px;
    letter-spacing: 0.4px;
  }
  .slide-title {
    font-size: 1.28rem;
    margin: 0 0 12px;
    font-weight: 500;
  }
  .slide-desc {
    font-size: 0.92rem;
    color: var(--text-2);
    margin: 0 0 20px;
    line-height: 1.55;
  }
  .slide-link {
    color: var(--text-1);
    text-decoration: none;
    font-size: 0.92rem;
    border-bottom: 1px solid #aaa;
    width: fit-content;
    transition: border-color 0.24s ease;
  }
  .slide-link:hover {
    border-color: var(--brand-main);
  }

  .carousel-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 2.8rem;
    height: 2.8rem;
    border-radius: 50%;
    border: none;
    /* 复用全局毛玻璃变量 */
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
    cursor: pointer;
    transition: background var(--transition-base);
    display: grid;
    place-items: center;
    z-index: 4 !important;
  }
  .prev-btn {
    left: 14px;
  }
  .next-btn {
    right: 14px;
  }
  .carousel-arrow:hover {
    background: var(--brand-main);
  }
  /* 箭头符号 */
  .carousel-arrow.prev-btn::before {
    content: '←';
    font-size: 22px;
    color: var(--text-1);
    transition: color var(--transition-base);
  }
  .carousel-arrow.next-btn::before {
    content: '→';
    font-size: 22px;
    color: var(--text-1);
    transition: color var(--transition-base);
  }
  /* hover箭头变白 */
  .carousel-arrow:hover::before {
    color: var(--color-white);
  }
  .swiper-button-next::after,
  .swiper-button-prev::after {
    display: none !important;
    content: none !important;
  }

  .cases-more-wrap {
    text-align: center;
  }
  .cases-more-link {
    color: var(--brand-main);
    text-decoration: none;
    transition: color var(--transition-base);
  }
  .cases-more-link:hover {
    color: var(--brand-hover);
  }

  @media (max-width: 1024px) {
    .carousel-slide {
      width: 580px;
    }
    .carousel-mask {
      width: 80px;
    }
    .slide-text-panel {
      padding: 28px 22px;
    }
    .slide-title {
      font-size: 1.12rem;
    }
    .carousel-arrow {
      width: 2.4rem;
      height: 2.4rem;
    }
  }
  @media (max-width: 768px) {
    .carousel-mask,
    .carousel-arrow {
      display: none;
    }
    .carousel-slide {
      width: 92vw;
    }
    .slide-inner {
      aspect-ratio: unset;
      grid-template-columns: 1fr;
      grid-template-rows: auto auto;
    }
    .slide-img-wrap {
      width: 100%;
      height: 52vw;
      min-height: 220px;
    }
    .carousel-slide:not(.active) .slide-inner {
      transform: none;
      opacity: 1;
      filter: none;
    }
    .slide-text-panel {
      padding: 20px 18px;
    }
    .slide-title {
      font-size: 1.02rem;
    }
  }
</style>
