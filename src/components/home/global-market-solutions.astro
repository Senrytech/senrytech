---
interface Props {
  locale: string;
}
const { locale } = Astro.props;

const marketSolutionList = [
  {
    countryName: 'Ecuador',
    title: 'Agriculture & Steel Structure Solution',
    desc: 'Tailored laser cutting equipment for Ecuador greenhouse frames, steel warehouse and agricultural machinery fabrication workshops.',
    image: '/assets/images/solutions/ecuador-steel-workshop.webp',
    linkHref: '/en/solutions/laser-cutting-ecuador/',
  },
  {
    countryName: 'Peru',
    title: 'Mining Machinery Metal Fabrication Solution',
    desc: 'Heavy-duty fiber laser cutters for Peru mining equipment, thick metal parts and metal processing factories.',
    image: '/assets/images/solutions/peru-mining-factory.webp',
    linkHref: '/en/solutions/laser-cutting-peru/',
  },
  {
    countryName: 'Brazil',
    title: 'Heavy Industry Laser Cutting Solution',
    desc: 'High-power laser cutting machines for Brazil heavy machinery, construction equipment and metal fabrication plants.',
    image: '/assets/images/solutions/brazil-heavy-industry.webp',
    linkHref: '/en/solutions/laser-cutting-brazil/',
  },
  {
    countryName: 'Indonesia',
    title: 'Construction Tube Processing Solution',
    desc: 'Sheet & tube combo laser cutters for Indonesia construction pipe, steel structure and metal building materials.',
    image: '/assets/images/solutions/indonesia-tube-factory.webp',
    linkHref: '/en/solutions/laser-cutting-indonesia/',
  },
];
---

<section class="global-market-solution-section">
  <div class="container">
    <h2 class="section-heading">Industry Laser Solutions for Global Markets</h2>

    <div class="solution-list">
      {
        marketSolutionList.map((item, idx) => {
          const isImageLeft = idx % 2 === 0;
          return (
            <a href={item.linkHref} class={`solution-row ${isImageLeft ? 'img-left' : 'img-right'}`}>
              <div class="solution-media-wrap">
                <img class="solution-media" src={item.image} alt={`Laser Cutting Solution for ${item.countryName} ${item.title}`} loading="lazy" />
              </div>
              <div class="solution-text-wrap">
                <h3>{item.countryName}</h3>
                <h4>{item.title}</h4>
                <p>{item.desc}</p>
                <span class="solution-link-text">View Localized Solution &rarr;</span>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .global-market-solution-section {
    padding: clamp(64px, 6vw, 96px) 0;
  }

  .global-market-solution-section .container {
    padding: 0 24px;
    max-width: 1400px;
    margin: 0 auto;
  }

  .section-heading {
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    margin: 0 0 48px;
    font-weight: 600;
    color: var(--text-1);
    text-align: center;
  }

  .solution-list {
    display: flex;
    flex-direction: column;
    gap: 64px;
  }

  .solution-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
    text-decoration: none;
    color: inherit;
  }

  .solution-row.img-right {
    grid-template-columns: 1fr 1fr;
  }

  .solution-row.img-right .solution-media-wrap {
    order: 2;
  }

  .solution-row.img-right .solution-text-wrap {
    order: 1;
  }

  .solution-media-wrap {
    overflow: hidden;
    border-radius: var(--radius-lg);
  }

  .solution-media {
    width: 100%;
    height: 320px;
    object-fit: cover;
    transition: transform var(--transition-base);
  }

  .solution-row:hover .solution-media {
    transform: scale(1.04);
  }

  .solution-text-wrap h3 {
    margin: 0 0 8px;
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--text-1);
  }

  .solution-text-wrap h4 {
    margin: 0 0 12px;
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--text-1);
  }

  .solution-text-wrap p {
    margin: 0 0 20px;
    color: var(--text-2);
    line-height: 1.7;
  }

  .solution-link-text {
    color: var(--brand-main);
    font-weight: 500;
    display: inline-block;
    transition: color var(--transition-base);
  }

  .solution-row:hover .solution-link-text {
    color: var(--brand-hover);
  }

  @media (max-width: 1024px) {
    .solution-media {
      height: 260px;
    }
  }

  @media (max-width: 768px) {
    .solution-row {
      grid-template-columns: 1fr;
    }

    .solution-row.img-right .solution-media-wrap,
    .solution-row.img-right .solution-text-wrap {
      order: initial;
    }

    .solution-media {
      height: 220px;
    }

    .solution-list {
      gap: 48px;
    }
  }
</style>
