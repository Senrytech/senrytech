---
import BaseLayout from '../../../layouts/baselayout.astro';

export async function getStaticPaths() {
  return [{ params: { country: 'ecuador' } }, { params: { country: 'peru' } }, { params: { country: 'brazil' } }, { params: { country: 'indonesia' } }];
}

const { country } = Astro.params;

type CountryKey = 'ecuador' | 'peru' | 'brazil' | 'indonesia';
const countryNameMap: Record<CountryKey, string> = {
  ecuador: 'Ecuador',
  peru: 'Peru',
  brazil: 'Brazil',
  indonesia: 'Indonesia',
};
const targetCountry = countryNameMap[country as CountryKey];

// Meta SEO 动态生成
const pageMeta = {
  title: `Laser Cutting Machine Solutions for ${targetCountry} Metal Fabrication | Senrytech`,
  description: `Senrytech provides tailored fiber laser cutting machine solutions for ${targetCountry} local metal workshops. Suitable for steel structure, mining machinery & tube processing. Factory direct price.`,
};
---

<BaseLayout title={pageMeta.title} desc={pageMeta.description} lang={Astro.currentLocale}>
  <main class="container page-solution-country">
    <h1>Fiber Laser Cutting Solutions for {targetCountry} Manufacturers</h1>

    <section>
      <h2>Local Industry Demand & Challenges</h2>
      <p>英文正文（厄瓜多尔本地工况、电网、主流材料、行业痛点）</p>
    </section>

    <section>
      <h2>Recommended Laser Equipment For Local Factories</h2>
      <p>适配机型介绍 + <a href="产品url">Senrytech S ECO</a> 这类内链</p>
      <p>内链指向对应通用行业方案：<a href="/en/solutions/agricultural-machinery-laser-cutting/">Agricultural Machinery Laser Cutting Solutions</a></p>
    </section>

    <section>
      <h2>Local Service & Support</h2>
      <p>港口、清关、备件、远程售后等本地化信息</p>
    </section>

    <section>
      <h2>Get Tailored Quotation For Your Workshop</h2>
      <a href="/en/contact-us" class="btn-primary">Contact Us For Custom Solution</a>
    </section>
  </main>
</BaseLayout>

<style>
  .page-solution-country {
    padding: 60px 0;
  }
  .page-solution-country h1 {
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    margin: 0 0 32px;
    color: var(--text-1);
  }
  .page-solution-country h2 {
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    margin: 40px 0 16px;
    color: var(--text-1);
  }
  .page-solution-country p {
    line-height: 1.7;
    color: var(--text-2);
    font-size: 1.05rem;
    max-width: 920px;
  }
  .btn-primary {
    display: inline-block;
    margin-top: 20px;
    padding: 12px 28px;
    background: var(--brand-main);
    color: var(--color-white);
    border-radius: 999px;
    text-decoration: none;
    transition: background var(--transition-base);
  }
  .btn-primary:hover {
    background: var(--brand-light);
  }
</style>
